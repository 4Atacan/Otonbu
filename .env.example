# Supabase CLI — supabase db push için gerekli (bundle'a girmez)
# supabase.com/dashboard/account/tokens → sbp_... formatında token
SUPABASE_ACCESS_TOKEN=

# İstemciye açık anahtarlar (anon key — güvenli, RLS arkasında)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry DSN (uygulama — istemci tarafı hata izleme)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# -------------------------------------------------------
# SADECE TEST için (scripts/test-rls.ts)
# Asla .env ana dosyasına koyma; ayrı .env.test kullan
# -------------------------------------------------------
# SUPABASE_SERVICE_ROLE_TEST=   <- test-rls.ts için, .env.test'e

# -------------------------------------------------------
# Aşağıdakiler ASLA istemciye verilmez.
# Edge Functions ortam değişkenleri olarak Supabase paneline girilir.
# -------------------------------------------------------
# SUPABASE_SERVICE_ROLE=   <- Edge Function env, BURAYA YAZMA
# IYZICO_SECRET=           <- Edge Function env, BURAYA YAZMA
# SMS_API_KEY=             <- Edge Function env, BURAYA YAZMA
# SENTRY_DSN_EDGE=         <- Edge Function env, BURAYA YAZMA
