# Supabase CLI — supabase db push için gerekli (bundle'a girmez)
# supabase.com/dashboard/account/tokens → sbp_... formatında token
SUPABASE_ACCESS_TOKEN=

# İstemciye açık anahtarlar (anon key — güvenli, RLS arkasında)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry DSN (uygulama — istemci tarafı hata izleme)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# hCaptcha site key — açık anahtar, istemcide CAPTCHA widget'ı için
# Cloudflare Turnstile yerine hCaptcha: TR mobil operatörlerinden erişim sorunsuz.
# Secret (SUPABASE_AUTH_CAPTCHA_SECRET) Supabase paneli env'inde durur, BURAYA YAZMA
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# R2 public bucket tabanı — public görselleri (avatar, katalog) servis eder.
# Public değer (herkese açık bucket URL'i), istemcide olması güvenli.
# Dev: r2.dev alt alan adı; prod: cdn.otonbugarage.com (custom domain).
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# -------------------------------------------------------
# SADECE TEST için (scripts/test-rls.ts)
# Asla .env ana dosyasına koyma; ayrı .env.test kullan
# -------------------------------------------------------
# SUPABASE_SERVICE_ROLE_TEST=   <- test-rls.ts için, .env.test'e

# -------------------------------------------------------
# Aşağıdakiler ASLA istemciye verilmez.
# Edge Functions ortam değişkenleri olarak Supabase paneline girilir.
# -------------------------------------------------------
# SUPABASE_SERVICE_ROLE=          <- Edge Function env, BURAYA YAZMA
# IYZICO_SECRET=                  <- Edge Function env, BURAYA YAZMA
# R2_ACCOUNT_ID=                  <- r2-imza Edge Function secret, BURAYA YAZMA
# R2_ACCESS_KEY=                  <- r2-imza Edge Function secret, BURAYA YAZMA
# R2_SECRET_KEY=                  <- r2-imza Edge Function secret, BURAYA YAZMA
# SMTP_PASS=                      <- Supabase Auth SMTP env (Resend/Brevo API key)
# SUPABASE_AUTH_CAPTCHA_SECRET=   <- Supabase Auth captcha secret (Turnstile)
# SENTRY_DSN_EDGE=                <- Edge Function env, BURAYA YAZMA
